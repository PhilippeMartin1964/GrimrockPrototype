# Generated output for any future project plugin that is intentionally versioned.
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/Saved/

# --- Optional build artifacts ---
Build/*

# Keep icon/config subfolders if ever needed later
!Build/**/
!Build/**/*.ico
!Build/**/*.png
!Build/**/*.icns
!Build/**/*.bmp
!Build/**/*.json
!Build/**/*.xml
!Build/**/*.target
!Build/**/*.modules

